{
  "size": [240, 172],
  "fit": [0.55, 0.75],
  "pixel": true,
  "data": { "coins": 0, "msg": "", "player": "", "goods": [] },
  "styles": {
    "btn": {
      "type": "box", "radius": 2, "bw": 1, "transition": 0.1,
      "color": "#3C7D3A", "color2": "#2C632B", "border": "#62B052",
      "hover": { "color": "#4E9A4A", "color2": "#3A7B37" },
      "press": { "scale": 0.94 }
    },
    "btn_grey": {
      "type": "box", "radius": 2, "bw": 1, "transition": 0.1,
      "color": "#3A4560", "color2": "#2C3550", "border": "#56658A",
      "hover": { "color": "#4A5778", "color2": "#384463" },
      "press": { "scale": 0.94 }
    },
    "label": { "type": "text", "align": [0.5, 0.5], "origin": [0.5, 0.5] }
  },
  "children": [
    {
      "type": "box", "w": 240, "h": 172, "radius": 3, "bw": 1,
      "color": "#1B2233", "color2": "#11161F", "border": "#3A4A6E",
      "appear": { "alpha": 0, "scale": 0.96, "duration": 0.18 }
    },
    { "type": "box", "x": 1, "y": 1, "w": 238, "h": 18, "radius": 2, "color": "#243049", "color2": "#1D2740" },
    { "type": "text", "x": 8, "y": 6, "text": "&lМагазин" },
    {
      "type": "group", "align": [1, 0], "origin": [1, 0], "x": -6, "y": 5, "w": 46, "h": 9,
      "layout": "row", "gap": 3, "cross": "center",
      "tooltip": "Монеты игрока {player}",
      "children": [
        { "type": "image", "src": "demo/coin.png", "w": 9, "h": 9 },
        { "type": "text", "text": "&e{coins}" }
      ]
    },
    {
      "type": "text", "if": "{msg} != ''", "align": [0.5, 0], "origin": [0.5, 0], "y": 22, "text": "{msg}",
      "appear": { "alpha": 0, "y": -3, "duration": 0.2 }
    },
    {
      "type": "scroll", "x": 6, "y": 33, "w": 228, "h": 112, "scroll_step": 14,
      "children": [
        {
          "type": "repeat", "for": "goods", "w": 220, "h": "auto", "layout": "column", "gap": 3,
          "template": {
            "type": "box", "w": "fill", "h": 26, "radius": 2, "bw": 1,
            "color": "#222B40", "border": "#33405E",
            "hover": { "color": "#2A3550" },
            "appear": { "alpha": 0, "x": -8, "duration": 0.22, "stagger": 0.05 },
            "children": [
              { "type": "item", "item": "{.item}", "size": 16, "x": 5, "align": [0, 0.5], "origin": [0, 0.5] },
              { "type": "text", "x": 26, "y": 4, "text": "{.name}" },
              { "type": "text", "x": 26, "y": 14, "text": "&7{.desc}" },
              {
                "style": "btn", "w": 44, "h": 16, "x": -5, "align": [1, 0.5], "origin": [1, 0.5],
                "action": "buy:{.id}", "disabled": "{coins} < {.price}",
                "tooltip": ["&fКупить: {.name}", "&7Цена: &e{.price}"],
                "layout": "row", "gap": 2, "cross": "center", "padding": 3,
                "children": [
                  { "type": "image", "src": "demo/coin.png", "w": 9, "h": 9 },
                  { "type": "text", "text": "{.price}" }
                ]
              }
            ]
          }
        }
      ]
    },
    { "type": "box", "x": 6, "y": 149, "w": 228, "h": 1, "color": "#33405E" },
    {
      "style": "btn", "x": 6, "y": 153, "w": 60, "h": 14, "action": "add",
      "tooltip": "Проверка: сервер обновит данные открытого окна",
      "children": [ { "style": "label", "text": "+50 монет" } ]
    },
    {
      "style": "btn_grey", "x": 174, "y": 153, "w": 60, "h": 14, "action": "close",
      "children": [ { "style": "label", "text": "Закрыть" } ]
    }
  ]
}
